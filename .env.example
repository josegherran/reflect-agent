# .env.example
# Copy this file to .env and fill in values.
# Required fields are marked (required); all others are optional.

# App
APP_ENV=development                     # optional; default: development
DEBUG=false                             # optional; default: false — never true in production
DATABASE_URL=                           # optional; not yet used
SECRET_KEY=                             # optional; not yet used
API_KEY=your-api-key                    # required — Wave 2 API authentication

# CORS — comma-separated allowed origins (optional; default: http://localhost:8000)
ALLOWED_ORIGINS=http://localhost:8000

# OpenTelemetry tracing — set both to enable Strands per-tool traces (optional)
STRANDS_OTEL_ENABLED=false
STRANDS_OTEL_ENDPOINT=http://localhost:4317

# LLM Provider — Anthropic (required for Wave 4 tool implementations)
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM Provider — AWS Bedrock (alternative to Anthropic)
BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key-id
BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-access-key
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
