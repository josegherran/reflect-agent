# .env.example
# Copy this file to .env and fill in your configuration values

# Example settings
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./db.sqlite3
SECRET_KEY=your-secret-key
API_KEY=your-api-key

# LLM Provider Configuration
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-opus-20240229

# Anthropic Native (if different from above)
ANTHROPIC_NATIVE_API_KEY=your-anthropic-native-api-key
ANTHROPIC_NATIVE_API_URL=https://api.anthropic.com/v1
ANTHROPIC_NATIVE_MODEL=claude-3-opus-20240229

# Ollama-compatible (local or remote)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# AWS Bedrock
BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key-id
BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-access-key
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0


# Gemini (Google)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-pro
